# .env.example - contains no real credentials.
# Copy to .env (cp .env.example .env) and put your own key in .env only.

# Which adapter LLMClient uses: gemini | openai
LLM_PROVIDER=gemini

# Google Gemini (free tier key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_LOCAL_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, local Ollama ...)
OPENAI_API_KEY=YOUR_LOCAL_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: where the SQLite database is stored (default ~/.study-agent/study-agent.db)
# STUDY_AGENT_DB=/absolute/path/study-agent.db
