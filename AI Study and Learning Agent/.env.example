# .env.example - contains no real credentials.
# Copy to .env (cp .env.example .env) and put your own key in .env only.

# Which adapter LLMClient uses: openai (default) | gemini
LLM_PROVIDER=openai

# OpenAI or any OpenAI-compatible endpoint (OpenRouter, Groq, local Ollama ...)
OPENAI_API_KEY=YOUR_LOCAL_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-sol

# Optional alternative: Google Gemini (used only with LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini)
# GEMINI_API_KEY=YOUR_LOCAL_API_KEY_HERE
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# Optional: where the SQLite database is stored (default ~/.study-agent/study-agent.db)
# STUDY_AGENT_DB=/absolute/path/study-agent.db

# Embeddings for retrieval: local (default, offline, no quota) | gemini (needs GEMINI_API_KEY)
EMBEDDING_PROVIDER=local

# Local profile and study reminders
# STUDENT_ID=student-1
# STUDENT_NAME=Your Name
# REMINDER_TIME=18:00
